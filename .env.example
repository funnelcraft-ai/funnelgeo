# Copy to .env and fill in. Never commit .env.

# --- Database -------------------------------------------------------------
# Owner role: runs migrations and the few system operations that must cross
# tenants (signup, login lookup, hostname resolution, super admin).
DATABASE_OWNER_URL=postgres://geo_owner:geo_owner@127.0.0.1:5432/geo_dev
# App role: used for every tenant request. Row-level security applies to it.
DATABASE_URL=postgres://geo_app:geo_app@127.0.0.1:5432/geo_dev
# Password the migrate script sets on the geo_app role (must match DATABASE_URL).
APP_DB_PASSWORD=geo_app

# --- API --------------------------------------------------------------------
PORT=4000
HOST=127.0.0.1
# Long random string. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Shared secret between the web app and the API. When set, the API only trusts
# the forwarded hostname from callers that send it.
INTERNAL_PROXY_SECRET=change-me-too
RATE_LIMIT_AUTH_PER_MINUTE=20

# --- Platform identity ------------------------------------------------------
# Agencies get <slug>.<PLATFORM_DOMAIN>. In development use "localhost":
# browsers resolve acme.localhost to your machine with no DNS setup.
PLATFORM_DOMAIN=localhost
# Shown only on the platform's own host (signup, super admin). Never shown to
# agencies' clients.
PLATFORM_NAME=FunnelGeo
# What agencies point their CNAME at.
CNAME_TARGET=domains.localhost
# Used to build links such as workspace and invite URLs.
PUBLIC_SCHEME=http
PUBLIC_PORT=3000

# --- Job queue ----------------------------------------------------------------
# Redis holds the queue of engine calls. Run "npm run worker" beside the API.
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=funnelgeo

# --- Answer engines -----------------------------------------------------------
# live: real engines. An engine is used only when both its key and model are set.
# mock: generated stand-in answers, for trying the product without keys. Runs
#       made this way are labelled as demo data. Refused when NODE_ENV=production.
ENGINE_MODE=live
OPENAI_API_KEY=
OPENAI_MODEL=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
# Calls per second to each engine, attempts before a call is given up and
# refunded, and how many calls one worker makes at a time.
ENGINE_CALLS_PER_SECOND=2
ENGINE_ATTEMPTS=3
WORKER_CONCURRENCY=4

# --- Prospect audits -----------------------------------------------------------
# live: the site check fetches the prospect's real website (needs internet access).
# mock: checks a made-up website instead, for development. Refused in production.
SITE_FETCH=live
# Requests one visitor may send through the website form per hour.
WIDGET_PER_HOUR=5

# --- Email ------------------------------------------------------------------
# Any SMTP provider works. Example: smtps://USER:PASSWORD@smtp.example.com:465
# Leave empty in development: emails are printed in the API log instead.
SMTP_URL=
# The address every email is sent from. Its domain needs SPF and DKIM set up
# with your provider. The display name is each agency's own.
MAIL_FROM=no-reply@localhost

# --- Uploads ----------------------------------------------------------------
# Where uploaded logos and favicons are stored (relative to apps/api).
# Keep this directory on persistent disk and include it in backups.
UPLOAD_DIR=data/uploads

# --- Super admin (used by: npm run seed:admin) ------------------------------
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --- Web --------------------------------------------------------------------
API_URL=http://127.0.0.1:4000
