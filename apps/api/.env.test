# Local test database only. No real secrets belong in this file.
DATABASE_OWNER_URL=postgres://geo_owner:geo_owner@127.0.0.1:5432/geo_test
DATABASE_URL=postgres://geo_app:geo_app@127.0.0.1:5432/geo_test
APP_DB_PASSWORD=geo_app
SESSION_SECRET=test-secret-test-secret-test-secret-test
INTERNAL_PROXY_SECRET=test-proxy-secret
RATE_LIMIT_AUTH_PER_MINUTE=100000
PLATFORM_DOMAIN=platform.test
PLATFORM_NAME=Test Platform
CNAME_TARGET=domains.platform.test
PUBLIC_SCHEME=https
PUBLIC_PORT=
NODE_ENV=test
UPLOAD_DIR=/tmp/geo-test-uploads
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=funnelgeo-test
ENGINE_ATTEMPTS=2
ENGINE_CALLS_PER_SECOND=500
WORKER_CONCURRENCY=8
