{
  "name": "@geo/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "worker": "tsx --env-file-if-exists=../../.env src/worker.ts",
    "start:worker": "node --env-file-if-exists=../../.env dist/worker.js",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "seed:admin": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "test": "node --env-file=.env.test --import tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "collector": "tsx --env-file-if-exists=../../.env src/collector-server.ts",
    "start:collector": "node --env-file-if-exists=../../.env dist/collector-server.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "bullmq": "^5.81.5",
    "fastify": "^5.0.0",
    "ioredis": "^5.11.1",
    "jose": "^5.9.0",
    "nodemailer": "^8.0.11",
    "pg": "^8.13.0",
    "puppeteer-core": "^24.43.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
