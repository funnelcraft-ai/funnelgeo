# Example reverse proxy for production: one entry point for the platform
# address, every agency subdomain and every verified custom domain.
#
# Certificates are issued on demand, and only for hostnames the API confirms
# (GET /internal/domain-check). Without that check anyone could point a domain
# here and make the server request certificates for it.
#
# Assumes the web app on 127.0.0.1:3000 and the API on 127.0.0.1:4000.
# Review against the current Caddy documentation before use.

{
	on_demand_tls {
		ask http://127.0.0.1:4000/internal/domain-check
	}
}

https:// {
	tls {
		on_demand
	}
	# Caddy passes the original Host header through, which is how the web app
	# and API know which workspace is being visited.
	reverse_proxy 127.0.0.1:3000
}
