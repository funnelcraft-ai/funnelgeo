{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["apps/api/**", "package-lock.json", "Dockerfile"]
  },
  "deploy": {
    "startCommand": "node apps/api/dist/collector-server.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
