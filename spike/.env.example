# Copy to spike/.env. Keys stay on your machine; spike/.env is git-ignored.
# An engine runs only when both its key and its model are set.
# Prices are per million tokens, in whichever currency you want the report in.
# Take models and prices from each provider's current documentation.

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_PRICE_IN_PER_MTOK=
OPENAI_PRICE_OUT_PER_MTOK=
# Flat fee per web search call, if the provider charges one.
OPENAI_PRICE_PER_SEARCH_CALL=0

PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=
PERPLEXITY_PRICE_IN_PER_MTOK=
PERPLEXITY_PRICE_OUT_PER_MTOK=
PERPLEXITY_PRICE_PER_SEARCH_CALL=0

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_PRICE_IN_PER_MTOK=
GEMINI_PRICE_OUT_PER_MTOK=
GEMINI_PRICE_PER_SEARCH_CALL=0

SPIKE_CONCURRENCY=3
